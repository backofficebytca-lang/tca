# Contact form — see docs/contact-form/README.md

# Resend: notification email
RESEND_API_KEY=
CONTACT_TO_EMAIL=backoffice.bytca@gmail.com
# Until a domain is verified in Resend, the sender must be onboarding@resend.dev
CONTACT_FROM="TCA Backoffice <onboarding@resend.dev>"

# Google Sheets: OAuth client + refresh token (run: node scripts/google-auth.mjs) + the sheet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
# Optional: name of the tab to write to (default: the first tab)
GOOGLE_SHEET_TAB=
